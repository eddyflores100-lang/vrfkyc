# Runtime secrets belong in the hosting settings, never in Pages or Git.
# Sites gateway only: do not enable this identity mode on an unprotected Worker.
VRFKYC_AUTH_MODE=sites
VRFKYC_LIVE_DATA_ENABLED=false
CSL_API_KEY=
OPENSANCTIONS_API_KEY=
VRFKYC_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_QUERY_LIMIT=100
